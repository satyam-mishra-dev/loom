{
  "name": "fleetline",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.json",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present && npm run test:signature && npm run test:e2e",
    "test:signature": "vitest run test/no-double-assignment.test.ts test/no-double-assignment-crash.test.ts",
    "test:e2e": "vitest run test/e2e-lifecycle.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@fleetline/core": "*",
    "@fleetline/db": "*",
    "@fleetline/matcher": "*",
    "@testcontainers/postgresql": "^10.13.0",
    "@testcontainers/redis": "^10.13.0",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.0",
    "eslint": "^9.9.0",
    "h3-js": "^4.1.0",
    "ioredis": "^5.4.0",
    "pg": "^8.12.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
