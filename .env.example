# Fleetline configuration. Copy to .env for local dev; docker-compose.yml wires
# the same names between containers. Every value here has a sane default in code
# — this file documents them, it is not required to run `docker compose up`.

# ---- infrastructure ----
# Host-mapped ports are 5434 (Postgres) and 6381 (Redis); inside compose the
# services reach each other on the default 5432 / 6379.
DATABASE_URL=postgres://fleetline:fleetline@127.0.0.1:5434/fleetline
REDIS_URL=redis://127.0.0.1:6381

# ---- gateway ----
# HMAC secret for the auth-lite WS token scheme (apps/gateway/src/auth.ts).
GATEWAY_SECRET=fleetline-dev-secret
# Per-source GCRA on ride-request intake (§5.7). Generous by default so a normal
# fleet never trips it; tighten to demo rejection. RATE_LIMIT_FAIL_CLOSED=true
# flips the limiter from fail-open (local fallback) to fail-closed on Redis loss.
RATE_LIMIT_RPS=200
RATE_LIMIT_BURST=400
RATE_LIMIT_WINDOW_MS=1000
RATE_LIMIT_FAIL_CLOSED=false

# ---- matcher (+ embedded janitor) ----
MATCHER_CONSUMERS=8
MATCH_NEED=8
MATCH_MAX_K=3
FRESH_MS=10000
# CLAIM_TTL_MS must exceed OFFER_TTL_MS (the claim outlives the offer it guards).
CLAIM_TTL_MS=12000
OFFER_TTL_MS=8000
MAX_OFFERS=5
JANITOR_SWEEP_MS=1000

# ---- read model / SSE ----
MATCHER_METRICS_URL=http://127.0.0.1:8090/metrics
READ_MODEL_TICK_MS=1000
CENTER_LAT=37.7749
CENTER_LNG=-122.4194

# ---- dashboard (baked at build time by Vite) ----
VITE_READMODEL_URL=http://localhost:4600

# ---- demo simulator (compose knobs) ----
SIM_DRIVERS=2000
SIM_RPS=20
SIM_HOTSPOTS=3
