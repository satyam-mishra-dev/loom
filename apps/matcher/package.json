{
  "name": "@loom/matcher",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "start": "tsx src/main.ts",
    "janitor": "tsx src/janitor-main.ts",
    "test:integration": "vitest run matcher.integration cascade.integration"
  },
  "dependencies": {
    "@loom/core": "*",
    "@loom/db": "*",
    "fastify": "^5.0.0",
    "ioredis": "^5.4.0",
    "pg": "^8.12.0",
    "pino": "^9.3.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.13.0",
    "@testcontainers/redis": "^10.13.0",
    "@types/pg": "^8.11.0",
    "vitest": "^3.0.0"
  }
}
